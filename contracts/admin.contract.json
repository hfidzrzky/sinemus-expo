{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "title": "Sinemus Super Admin & Scanner Contracts",
  "description": "Single Source of Truth (SSOT) untuk Super Admin Studio, CRUD Katalog, Mobile Scanner, dan Entitlement Access",
  "version": "2.1.0",
  "endpoints": {
    "validateTicketQR": {
      "method": "POST",
      "path": "/api/v1/admin/tickets/validate",
      "description": "Memvalidasi hash QR tiket dari kamera mobile scanner dan menandai check-in",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "type": "object",
        "required": [
          "qr_hash"
        ],
        "properties": {
          "qr_hash": {
            "type": "string"
          },
          "device_info": {
            "type": "string"
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "ticket_code",
              "event_title",
              "buyer_name",
              "seating_type",
              "ticket_quantity",
              "checkin_status",
              "scanned_at"
            ],
            "properties": {
              "ticket_code": {
                "type": "string"
              },
              "event_title": {
                "type": "string"
              },
              "buyer_name": {
                "type": "string"
              },
              "seating_type": {
                "type": "string",
                "enum": [
                  "assigned_seating",
                  "general_admission"
                ]
              },
              "ticket_quantity": {
                "type": "integer",
                "default": 1
              },
              "seat_codes": {
                "type": [
                  "array",
                  "null"
                ],
                "items": {
                  "type": "string"
                }
              },
              "checkin_status": {
                "type": "string",
                "enum": [
                  "checked_in"
                ]
              },
              "scanned_at": {
                "type": "string",
                "format": "date-time"
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "getDashboardStats": {
      "method": "GET",
      "path": "/api/v1/admin/dashboard/stats",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "total_revenue",
              "formatted_total_revenue",
              "total_tickets_sold",
              "active_movies_count",
              "upcoming_events_count"
            ],
            "properties": {
              "total_revenue": {
                "type": "number"
              },
              "formatted_total_revenue": {
                "type": "string"
              },
              "total_tickets_sold": {
                "type": "integer"
              },
              "active_movies_count": {
                "type": "integer"
              },
              "upcoming_events_count": {
                "type": "integer"
              },
              "top_performers": {
                "type": "array",
                "items": {
                  "type": "object",
                  "required": [
                    "id",
                    "title",
                    "type",
                    "poster_url",
                    "total_sales_count",
                    "occupancy_rate",
                    "gross_revenue",
                    "net_revenue",
                    "formatted_net_revenue",
                    "growth_percentage"
                  ],
                  "properties": {
                    "id": {
                      "type": "integer"
                    },
                    "title": {
                      "type": "string"
                    },
                    "type": {
                      "type": "string",
                      "enum": [
                        "movie",
                        "event"
                      ]
                    },
                    "poster_url": {
                      "type": [
                        "string",
                        "null"
                      ]
                    },
                    "total_sales_count": {
                      "type": "integer",
                      "description": "Jumlah sewa VoD atau jumlah tiket event"
                    },
                    "occupancy_rate": {
                      "type": [
                        "number",
                        "null"
                      ],
                      "description": "Persentase okupansi kursi (khusus event), null untuk movie"
                    },
                    "gross_revenue": {
                      "type": "number"
                    },
                    "net_revenue": {
                      "type": "number"
                    },
                    "formatted_net_revenue": {
                      "type": "string"
                    },
                    "growth_percentage": {
                      "type": "number",
                      "description": "Pertumbuhan omzet dibanding periode sebelumnya"
                    }
                  }
                }
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "grantMovieAccess": {
      "method": "POST",
      "path": "/api/v1/admin/movie-access/grant",
      "description": "Memberikan hak tonton film gratis/promo ke user di user_movie_access tanpa transaksi finansial",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "type": "object",
        "required": [
          "user_id",
          "movie_id",
          "duration_hours"
        ],
        "properties": {
          "user_id": {
            "type": "integer"
          },
          "movie_id": {
            "type": "integer"
          },
          "duration_hours": {
            "type": "integer",
            "default": 48
          },
          "admin_notes": {
            "type": [
              "string",
              "null"
            ],
            "description": "Alasan pemberian akses (Giveaway / Reviewer)"
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "access_id",
              "user_email",
              "movie_title",
              "rental_expires_at",
              "access_status"
            ],
            "properties": {
              "access_id": {
                "type": "integer"
              },
              "user_email": {
                "type": "string"
              },
              "movie_title": {
                "type": "string"
              },
              "rental_expires_at": {
                "type": "string",
                "format": "date-time"
              },
              "access_status": {
                "type": "string",
                "enum": [
                  "active"
                ]
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "revokeMovieAccess": {
      "method": "POST",
      "path": "/api/v1/admin/movie-access/{id}/revoke",
      "description": "Mencabut hak tonton film user dengan alasan pencabutan",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "type": "object",
        "required": [
          "revoke_reason"
        ],
        "properties": {
          "revoke_reason": {
            "type": "string",
            "enum": [
              "refund",
              "violation",
              "system_error",
              "manual_admin"
            ]
          },
          "admin_notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "listAdminOrders": {
      "method": "GET",
      "path": "/api/v1/admin/orders",
      "description": "Mengambil riwayat transaksi tiket dan sewa film untuk audit finansial",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "queryParameters": {
        "type": {
          "type": "string",
          "enum": [
            "all",
            "ticket",
            "movie_rental"
          ]
        },
        "status": {
          "type": "string",
          "enum": [
            "all",
            "pending",
            "paid",
            "expired",
            "failed"
          ]
        },
        "page": {
          "type": "integer",
          "default": 1
        },
        "per_page": {
          "type": "integer",
          "default": 20
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "meta",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/AdminOrderItem"
            }
          },
          "meta": {
            "$ref": "#/definitions/PaginationMeta"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "verifyStreamUID": {
      "method": "POST",
      "path": "/api/v1/admin/cloudflare/stream/verify",
      "description": "Memverifikasi UID video ke Cloudflare Stream API dan mengembalikan pratinjau metadata",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "type": "object",
        "required": [
          "uid"
        ],
        "properties": {
          "uid": {
            "type": "string",
            "pattern": "^[a-f0-9]{32}$"
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": [
              "object",
              "null"
            ],
            "properties": {
              "uid": {
                "type": "string"
              },
              "status": {
                "type": "string"
              },
              "is_ready": {
                "type": "boolean"
              },
              "duration_seconds": {
                "type": "number"
              },
              "formatted_duration": {
                "type": "string"
              },
              "thumbnail_url": {
                "type": "string",
                "format": "uri"
              },
              "preview_iframe_url": {
                "type": "string",
                "format": "uri"
              },
              "playback_hls_url": {
                "type": "string"
              },
              "meta": {
                "type": "object"
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "createImageDirectUpload": {
      "method": "POST",
      "path": "/api/v1/admin/cloudflare/images/direct-upload",
      "description": "Menerbitkan One-Time Direct Creator Upload URL untuk Cloudflare Images",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "type": "object",
        "properties": {
          "asset_type": {
            "type": "string",
            "enum": [
              "event_poster",
              "event_backdrop",
              "movie_poster",
              "movie_backdrop",
              "banner",
              "general",
              "movie_look_film",
              "movie_look_films"
            ]
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "image_id",
              "upload_url",
              "delivery_url"
            ],
            "properties": {
              "image_id": {
                "type": "string"
              },
              "upload_url": {
                "type": "string",
                "format": "uri"
              },
              "delivery_url": {
                "type": "string",
                "format": "uri"
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "deleteCloudflareImage": {
      "method": "DELETE",
      "path": "/api/v1/admin/cloudflare/images/{id}",
      "description": "Menghapus berkas gambar dari Cloudflare Images",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean"
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "properties": {
              "image_id": {
                "type": "string"
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "listAdminUsers": {
      "method": "GET",
      "path": "/api/v1/admin/users",
      "description": "Menampilkan daftar pengguna terdaftar, status role, dan status penguncian WhatsApp",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "queryParameters": {
        "search": {
          "type": "string"
        },
        "role": {
          "type": "string",
          "enum": [
            "all",
            "customer",
            "super_admin"
          ]
        },
        "phone_locked": {
          "type": "string",
          "enum": [
            "all",
            "locked",
            "unlocked"
          ]
        },
        "is_phone_locked": {
          "type": "boolean"
        },
        "page": {
          "type": "integer",
          "default": 1
        },
        "per_page": {
          "type": "integer",
          "default": 20
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "meta",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "array",
            "items": {
              "$ref": "#/definitions/AdminUserListItem"
            }
          },
          "meta": {
            "$ref": "#/definitions/PaginationMeta"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "getAdminUserDetail": {
      "method": "GET",
      "path": "/api/v1/admin/users/{id}",
      "description": "Menampilkan profil lengkap pengguna, status verifikasi, dan riwayat pesanan tiket serta sewa film",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/definitions/AdminUserDetail"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "updateAdminUserRole": {
      "method": "PUT",
      "path": "/api/v1/admin/users/{id}/role",
      "description": "Memperbarui peran pengguna dengan proteksi anti-lockout Super Admin",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "type": "object",
        "required": [
          "role"
        ],
        "properties": {
          "role": {
            "type": "string",
            "enum": [
              "customer",
              "super_admin"
            ]
          },
          "admin_notes": {
            "type": [
              "string",
              "null"
            ]
          }
        }
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/definitions/AdminUserDetail"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "getSystemSettings": {
      "method": "GET",
      "path": "/api/v1/admin/settings",
      "description": "Mengambil seluruh konfigurasi pengaturan sistem beserta metadata audit untuk Super Admin Studio",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "type": "object",
            "required": [
              "business_policies",
              "public_contact",
              "emergency_controls",
              "audit_meta"
            ],
            "properties": {
              "business_policies": {
                "$ref": "#/definitions/BusinessPoliciesConfig"
              },
              "public_contact": {
                "$ref": "#/definitions/PublicContactConfig"
              },
              "emergency_controls": {
                "$ref": "#/definitions/EmergencyControlsConfig"
              },
              "audit_meta": {
                "$ref": "#/definitions/SystemSettingsAuditMeta"
              }
            }
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "updateBusinessPolicies": {
      "method": "PUT",
      "path": "/api/v1/admin/settings/business-policies",
      "description": "Memperbarui kebijakan bisnis, timeout seat lock, durasi sewa VoD, dan fee layanan",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "$ref": "#/definitions/BusinessPoliciesConfig"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/definitions/BusinessPoliciesConfig"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "updatePublicContact": {
      "method": "PUT",
      "path": "/api/v1/admin/settings/public-contact",
      "description": "Memperbarui kontak bantuan WhatsApp admin, email support, dan akun media sosial",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "$ref": "#/definitions/PublicContactConfig"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/definitions/PublicContactConfig"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    },
    "updateEmergencyControls": {
      "method": "PUT",
      "path": "/api/v1/admin/settings/emergency-controls",
      "description": "Memperbarui sakelar mode pemeliharaan, freeze tiket war, dan banner darurat",
      "headers": {
        "Authorization": "Bearer {token}"
      },
      "request": {
        "$ref": "#/definitions/EmergencyControlsConfig"
      },
      "response": {
        "type": "object",
        "required": [
          "success",
          "message",
          "data",
          "server_time"
        ],
        "properties": {
          "success": {
            "type": "boolean",
            "const": true
          },
          "message": {
            "type": "string"
          },
          "data": {
            "$ref": "#/definitions/EmergencyControlsConfig"
          },
          "server_time": {
            "type": "string",
            "format": "date-time"
          }
        }
      }
    }
  },
  "definitions": {
    "AdminUserListItem": {
      "type": "object",
      "description": "Representasi item pengguna terdaftar pada tabel direktori admin.",
      "required": [
        "id",
        "name",
        "email",
        "role",
        "is_phone_locked",
        "total_orders_count",
        "total_paid_transactions",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "name": {
          "type": "string"
        },
        "email": {
          "type": "string"
        },
        "avatar_url": {
          "type": [
            "string",
            "null"
          ],
          "format": "uri"
        },
        "phone_number": {
          "type": [
            "string",
            "null"
          ]
        },
        "is_phone_locked": {
          "type": "boolean"
        },
        "birth_date": {
          "type": [
            "string",
            "null"
          ],
          "format": "date"
        },
        "age": {
          "type": [
            "integer",
            "null"
          ]
        },
        "role": {
          "type": "string",
          "enum": [
            "customer",
            "super_admin"
          ]
        },
        "is_profile_completed": {
          "type": "boolean"
        },
        "paid_ticket_orders_count": {
          "type": "integer"
        },
        "paid_movie_orders_count": {
          "type": "integer"
        },
        "total_paid_transactions": {
          "type": "integer"
        },
        "total_orders_count": {
          "type": "integer"
        },
        "last_login_at": {
          "type": [
            "string",
            "null"
          ],
          "format": "date-time"
        },
        "created_at": {
          "type": "string",
          "format": "date-time"
        }
      }
    },
    "AdminUserDetail": {
      "type": "object",
      "description": "Representasi detail profil pengguna dan seluruh riwayat transaksi serta hak akses.",
      "required": [
        "id",
        "name",
        "email",
        "role",
        "is_phone_locked",
        "total_orders_count",
        "total_paid_transactions",
        "recent_orders",
        "recent_ticket_transactions",
        "recent_movie_transactions",
        "active_movie_access",
        "created_at"
      ],
      "properties": {
        "id": {
          "type": "integer"
        },
        "google_id_masked": {
          "type": [
            "string",
            "null"
          ]
        },
